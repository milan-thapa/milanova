# Database
DATABASE_URL="postgresql://user:password@localhost:5432/milanova"

# App URL (for OG metadata and absolute URLs)
NEXT_PUBLIC_APP_URL="https://milanova.vercel.app"

# Resend Email Service
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_TO_EMAIL="info@yourdomain.com"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Admin Email Whitelist (comma-separated)
# Add your email here to automatically get admin role on first login
ADMIN_EMAILS=thapamilan9762@gmail.com

# Redis Configuration (for production rate limiting and caching)
# For local development, you can skip this (falls back to in-memory)
# For production, use Redis or Upstash
REDIS_URL=redis://localhost:6379
# Or use Upstash Redis:
# UPSTASH_REDIS_REST_URL=https://your-upstash-url

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# CSRF Protection
CSRF_SECRET=your_random_csrf_secret_change_in_production
