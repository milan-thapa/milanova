generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  description String
  challenge   String
  whatWeDid   String
  category    String
  year        Int
  clientName  String
  tags        String[]
  isFeatured  Boolean  @default(false)
  coverImage  String
  mockupImage String
  stats       String[]
  createdAt   DateTime @default(now())
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]
}

model Author {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  bio         String?
  image       String?
  role        String?
  twitter     String?
  linkedin    String?
  github      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]
}

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String?  // Legacy field - will be removed after migration
  categoryId  String?
  categoryRel Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        String[]
  author      String?  // Legacy field - will be removed after migration
  authorId    String?
  authorRel   Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime
  coverImage  String
  readingTime Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  relatedPosts BlogRelatedPost[] @relation("BlogToRelated")
  relatedBy    BlogRelatedPost[] @relation("RelatedToBlog")
}

model BlogRelatedPost {
  blogId       String
  relatedBlogId String
  blog         Blog @relation("BlogToRelated", fields: [blogId], references: [id], onDelete: Cascade)
  relatedBlog  Blog @relation("RelatedToBlog", fields: [relatedBlogId], references: [id], onDelete: Cascade)

  @@id([blogId, relatedBlogId])
}

model ContactSubmission {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  projectDetails String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Testimonial {
  id      String @id @default(cuid())
  name    String
  role    String
  company String
  quote   String
  image   String
  order   Int
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

enum UserRole {
  USER
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Milanova")
  siteTagline     String?
  siteDescription String?
  whatsappNumber  String?
  whatsappUrl     String?
  email           String?
  phone           String?
  address         String?
  facebookUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  linkedinUrl     String?
  heroHeadline    String?
  heroSubheadline String?
  heroTags        String?
  heroCtaText     String?
  heroCtaUrl      String?
  heroBadgeText   String?
  updatedAt       DateTime @updatedAt
}

model NavigationLink {
  id        String   @id @default(cuid())
  name      String
  href      String
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
